<?xml version="1.0" encoding="utf-8"?>
<!-- Enhanced Keyboard Styles -->
<resources>
    <!-- Base Keyboard Key Style -->
    <style name="KeyboardKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/key_normal_bg</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- Special Keys (Shift, Backspace, etc) -->
    <style name="KeyboardSpecialKey" parent="KeyboardKey">
        <item name="android:background">@drawable/key_special_bg</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#AAAAAA</item>
    </style>

    <!-- Space Bar -->
    <style name="KeyboardSpaceKey" parent="KeyboardKey">
        <item name="android:background">@drawable/key_space_bg</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#AAAAAA</item>
    </style>

    <!-- Enter Key with Gradient -->
    <style name="KeyboardEnterKey" parent="KeyboardKey">
        <item name="android:background">@drawable/key_enter_bg</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20sp</item>
    </style>
</resources>

<!-- Drawables to create in res/drawable/ -->

<!-- key_normal_bg.xml -->
<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#0D000000"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    
    <!-- Main key background -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#2A2A2A"
                android:endColor="#1A1A1A"/>
            <corners android:radius="12dp"/>
            <stroke
                android:width="1dp"
                android:color="#333333"/>
        </shape>
    </item>
</layer-list>

