<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/btn_message"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_gravity="center"
        android:src="@drawable/menu_item_glow" 
        android:padding="15dp"
        android:tint="#F5F5F5"
        android:contentDescription="Message"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/btn_settings"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_gravity="center"
        android:src="@drawable/menu_item_glow" 
        android:padding="15dp"
        android:tint="#F5F5F5"
        android:contentDescription="Settings"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/btn_ai"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_gravity="center"
        android:src="@drawable/menu_item_glow" 
        android:padding="15dp"
        android:tint="#F5F5F5"
        android:contentDescription="AI"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/btn_keyboard"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_gravity="center"
        android:src="@drawable/menu_item_glow" 
        android:padding="15dp"
        android:tint="#F5F5F5"
        android:contentDescription="Keyboard"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/btn_security"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_gravity="center"
        android:src="@drawable/menu_item_glow" 
        android:padding="15dp"
        android:tint="#F5F5F5"
        android:contentDescription="Security"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/bubble_icon"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:background="@drawable/glow_gradient_ring"
        android:src="@drawable/ic_fire" 
        android:padding="20dp" 
        android:contentDescription="Chat Head"
        android:layout_gravity="center"
        android:elevation="10dp" 
        android:tint="#F5F5F5"/>

</FrameLayout>