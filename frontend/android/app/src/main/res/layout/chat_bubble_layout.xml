<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Main Bubble Icon (No rotation) -->
    <ImageView
        android:id="@+id/bubble_icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/glow_gradient_ring"
        android:src="@drawable/new_logo"
        android:padding="11dp"
        android:contentDescription="Chat Head"
        android:layout_gravity="center"
        android:elevation="10dp"
        />

    <!-- Menu Items (Initially Hidden) with BLACK backgrounds -->
    
    <!-- AI Chat Button -->
    <ImageView
        android:id="@+id/btn_ai"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/circle_bg_black"
        android:src="@drawable/chatbot"
        android:padding="12dp"
        android:contentDescription="chatbot"
        android:layout_gravity="center"
        android:elevation="8dp"
        android:tint="#FFFFFF"
        android:visibility="gone"/>

    <!-- Scanner Button -->
    <ImageView
        android:id="@+id/btn_scanner"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/circle_bg_black"
        android:src="@drawable/shield"
        android:padding="10dp"
        android:contentDescription="Screen Scanner"
        android:layout_gravity="center"
        android:elevation="8dp"
        android:tint="#FFFFFF"
        android:visibility="gone"/>

    <!-- Voice Commands Button -->
    <ImageView
        android:id="@+id/btn_keyboard"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/circle_bg_black"
        android:src="@drawable/keyboard"
        android:padding="12dp"
        android:contentDescription="Voice Commands"
        android:layout_gravity="center"
        android:elevation="8dp"
        android:tint="#FFFFFF"
        android:visibility="gone"/>

    <!-- Settings Button -->
    <ImageView
        android:id="@+id/btn_settings"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/circle_bg_black"
        android:src="@drawable/settings"
        android:padding="12dp"
        android:contentDescription="Settings"
        android:layout_gravity="center"
        android:elevation="8dp"
        android:tint="#FFFFFF"
        android:visibility="gone"/>

    <!-- Refresh Button -->
    <ImageView
        android:id="@+id/btn_refresh"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/circle_bg_black"
        android:src="@drawable/ai_chatbot"
        android:padding="12dp"
        android:contentDescription="Refresh"
        android:layout_gravity="center"
        android:elevation="8dp"
        android:tint="#FFFFFF"
        android:visibility="gone"/>

</FrameLayout>
